{
    "name": "traitors",
    "version": "1.0.0",
    "private": true,
    "description": "A social deduction game to play online with friends",
    "homepage": "https://www.tannerkrewson.com/traitors/",
    "bugs": {
        "url": "https://github.com/tannerkrewson/traitors/issues"
    },
    "license": "MIT",
    "author": "Tanner Krewson",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tannerkrewson/traitors.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --mode nova && node -e \"if (require('fs').statSync('dist/game.html').size > 2 * 1024 * 1024) throw Error('Nova HTML exceeds 2 MiB')\"",
        "test": "vite build --mode nova && vitest run",
        "format": "oxfmt --check",
        "lint": "oxlint",
        "prepare": "lefthook install"
    },
    "dependencies": {
        "bootstrap": "^5.3.6",
        "knuth-shuffle": "^1.0.8",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.5.0"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/browser-playwright": "^5.1.2",
        "lefthook": "^2.2.4",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "playwright": "^1.65.1",
        "vite": "^8.4.0",
        "vite-plugin-singlefile": "^2.3.4",
        "vitest": "^5.1.2"
    },
    "engines": {
        "node": ">=26"
    }
}
